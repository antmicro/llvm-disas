+char *LLVMGetDisasmCPUs(const char *TT){
+  std::string Error;
+  const Target *TheTarget = TargetRegistry::lookupTarget(TT, Error);
+  if (!TheTarget)
+    return 0;
+
+  std::unique_ptr<const MCSubtargetInfo> STI(
+      TheTarget->createMCSubtargetInfo(TT, "", ""));
+  if (!STI)
+    return 0;
+
+  ArrayRef<StringRef> CPUNames = STI->getAllProcessorNames();
+
+  size_t Length = 0;
+  const char *Separator = ";";
+
+  for (auto &Name : CPUNames) {
+    Length += strlen(Name.str().c_str());
+    Length += strlen(Separator);
+  }
+ 
+  // Don't count trailing separator. It'll be later replaced by a null character.
+  Length -= strlen(Separator);
+
+  char *Out = (char*)malloc(Length * sizeof(char) + 1);
+
+  if (Out == NULL)
+    return NULL;
+
+  size_t Offset = 0;
+  for (auto &Name : CPUNames) {
+    memcpy(Out + Offset, Name.str().c_str(), strlen(Name.str().c_str()));
+    Offset += strlen(Name.str().c_str());
+    memcpy(Out + Offset, Separator, strlen(Separator));
+    Offset += strlen(Separator);
+  }
+
+  Out[Length] = '\0';
+
+  return Out;
+}
+
 //
 // LLVMSetDisasmOptions() sets the disassembler's options.  It returns 1 if it
 // can set all the Options and 0 otherwise.
